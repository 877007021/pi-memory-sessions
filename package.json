{
	"name": "pi-memory-sessions",
	"version": "0.1.0",
	"description": "Pi extension: keyword recall over your past pi sessions, stored in a self-owned SQLite index with CJK-aware search",
	"type": "module",
	"main": "index.ts",
	"keywords": [
		"pi",
		"pi-package",
		"pi-coding-agent",
		"memory",
		"session",
		"recall",
		"search",
		"sqlite",
		"fts5",
		"chinese",
		"cjk"
	],
	"pi": {
		"extensions": ["./index.ts"]
	},
	"files": [
		"index.ts",
		"src/",
		"README.md",
		"DESIGN.md",
		"LICENSE"
	],
	"scripts": {
		"test": "node --test test/unit.test.ts",
		"smoke": "node --no-warnings bench/smoke.ts",
		"bench": "node --no-warnings bench/replay.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.0.0",
		"@earendil-works/pi-ai": ">=1.0.0"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/877007021/pi-memory-sessions.git"
	},
	"bugs": {
		"url": "https://github.com/877007021/pi-memory-sessions/issues"
	},
	"homepage": "https://github.com/877007021/pi-memory-sessions#readme",
	"author": "nanh",
	"license": "MIT"
}
