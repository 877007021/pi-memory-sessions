{
	"name": "pi-memory-sessions",
	"version": "0.1.0",
	"description": "Pi extension: long-term keyword recall over past session transcripts (SQLite FTS5, CJK-aware, zero dependencies)",
	"type": "module",
	"main": "index.ts",
	"keywords": ["pi", "pi-package", "pi-coding-agent", "memory", "search", "sqlite", "fts5"],
	"pi": {
		"extensions": ["./index.ts"]
	},
	"scripts": {
		"test": "node --test test/",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"bench": "node --no-warnings bench/replay.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.0.0",
		"@earendil-works/pi-ai": ">=1.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"typescript": "^5.9.0"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"license": "MIT"
}
